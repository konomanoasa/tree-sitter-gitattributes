{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gitattributes",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_line_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "blank_line"
            },
            {
              "type": "SYMBOL",
              "name": "comment"
            },
            {
              "type": "SYMBOL",
              "name": "attribute_rule"
            },
            {
              "type": "SYMBOL",
              "name": "macro_definition"
            }
          ]
        }
      ]
    },
    "line_ending": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_end": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_layout"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "line_ending"
            },
            {
              "type": "SYMBOL",
              "name": "_eof"
            }
          ]
        }
      ]
    },
    "blank_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_blank_start"
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_comment_start"
        },
        {
          "type": "SYMBOL",
          "name": "comment_marker"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "comment_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "attribute_rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_rule_start"
        },
        {
          "type": "FIELD",
          "name": "pattern",
          "content": {
            "type": "SYMBOL",
            "name": "pattern"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "macro_definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_macro_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_macro_name"
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "opening",
                  "content": {
                    "type": "SYMBOL",
                    "name": "quote_open"
                  }
                },
                {
                  "type": "SYMBOL",
                  "name": "_macro_name"
                },
                {
                  "type": "FIELD",
                  "name": "closing",
                  "content": {
                    "type": "SYMBOL",
                    "name": "quote_close"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "_macro_name": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "marker",
          "content": {
            "type": "SYMBOL",
            "name": "macro_marker"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "attribute_name"
          }
        }
      ]
    },
    "_attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_separator"
        },
        {
          "type": "SYMBOL",
          "name": "attribute"
        }
      ]
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_attribute_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "modifier",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "unset_marker"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "unspecified_marker"
                  }
                ]
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "attribute_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "operator",
                  "content": {
                    "type": "SYMBOL",
                    "name": "assignment_operator"
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "FIELD",
                      "name": "value",
                      "content": {
                        "type": "SYMBOL",
                        "name": "attribute_value"
                      }
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_attribute_end"
        }
      ]
    },
    "attribute_name": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_name_start"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "name_text"
              },
              {
                "type": "SYMBOL",
                "name": "quoted_escape"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_name_end"
        }
      ]
    },
    "attribute_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_value_start"
        },
        {
          "type": "SYMBOL",
          "name": "value_text"
        },
        {
          "type": "SYMBOL",
          "name": "_value_end"
        }
      ]
    },
    "pattern": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "REPEAT1",
              "content": {
                "type": "SYMBOL",
                "name": "_glob"
              }
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "opening",
                  "content": {
                    "type": "SYMBOL",
                    "name": "quote_open"
                  }
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_glob"
                  }
                },
                {
                  "type": "FIELD",
                  "name": "closing",
                  "content": {
                    "type": "SYMBOL",
                    "name": "quote_close"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_pattern_end"
        }
      ]
    },
    "_glob": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "glob_literal"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_glob_start"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "wildcard"
                },
                {
                  "type": "SYMBOL",
                  "name": "recursive_wildcard"
                },
                {
                  "type": "SYMBOL",
                  "name": "single_character"
                },
                {
                  "type": "SYMBOL",
                  "name": "path_separator"
                },
                {
                  "type": "SYMBOL",
                  "name": "escape"
                },
                {
                  "type": "SYMBOL",
                  "name": "quoted_escape"
                },
                {
                  "type": "SYMBOL",
                  "name": "character_set"
                }
              ]
            }
          ]
        }
      ]
    },
    "glob_literal": {
      "type": "SYMBOL",
      "name": "_literal"
    },
    "character_set": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "SYMBOL",
            "name": "set_open"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "negation",
              "content": {
                "type": "SYMBOL",
                "name": "set_negation"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_set_item"
          }
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "set_close"
          }
        }
      ]
    },
    "_set_item": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_set_item_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "set_text"
            },
            {
              "type": "SYMBOL",
              "name": "escape"
            },
            {
              "type": "SYMBOL",
              "name": "quoted_escape"
            },
            {
              "type": "SYMBOL",
              "name": "character_range"
            },
            {
              "type": "SYMBOL",
