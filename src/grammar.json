            }
          ]
        }
      ]
    },
    "character_range": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_range_start"
        },
        {
          "type": "FIELD",
          "name": "lower",
          "content": {
            "type": "SYMBOL",
            "name": "_endpoint"
          }
        },
        {
          "type": "SYMBOL",
          "name": "range_operator"
        },
        {
          "type": "FIELD",
          "name": "upper",
          "content": {
            "type": "SYMBOL",
            "name": "_endpoint"
          }
        }
      ]
    },
    "_endpoint": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "range_character"
        },
        {
          "type": "SYMBOL",
          "name": "escape"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_escape"
        }
      ]
    },
    "character_class": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_compound_open"
          },
          "named": false,
          "value": "["
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_class_open"
          },
          "named": false,
          "value": ":"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_class_piece"
          }
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_class_close"
          },
          "named": false,
          "value": ":"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_compound_close"
          },
          "named": false,
          "value": "]"
        }
      ]
    },
    "_class_piece": {
      "type": "FIELD",
      "name": "name",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "class_name"
          },
          {
            "type": "SYMBOL",
            "name": "quoted_escape"
          }
        ]
      }
    }
