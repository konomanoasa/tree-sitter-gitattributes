CompileFlags:
  Add:
    - -std=c17
    - -xc
    - -Wall
    - -Wextra
    - -Werror
    - -pedantic

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header

---
# The included scanner's helpers look unused to clangd, which drops those
# diagnostics but still counts them toward its error limit.
If:
  PathMatch: (.*/)?test/[^/]*\.c
CompileFlags:
  Add:
    - -Wno-unused-function
